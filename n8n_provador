    {
      "parameters": {
        "jsCode": "const body = $('Entrada de Dados (Webhook)').first().json.body || {};\nconst clienteId = body.cliente_id || body.customer_id || \"ANONYMOUS\";\nconst produto = body.produto || {};\n\n// 1. Obtém a tabela enviada direto no objeto do produto\nconst tabelaOriginal = Array.isArray(produto.tabela_medidas) ? produto.tabela_medidas : [];\nconst possuiTabela = tabelaOriginal.length > 0;\n\n// Remove valores nulos/vazios das faixas do produto para economizar tokens\nconst tabelaLimpa = tabelaOriginal.map(row => {\n  const rowLimpa = {};\n  for (const [chave, valor] of Object.entries(row)) {\n    if (valor !== null && valor !== \"\" && valor !== undefined) {\n      rowLimpa[chave] = valor;\n    }\n  }\n  return rowLimpa;\n});\n\n// 2. Extrai APENAS as medidas corporais do cliente\nconst camposMedidas = ['cintura', 'busto', 'quadril', 'altura', 'comprimento_corpo', 'coxa', 'ombro'];\nconst medidasClienteLimpas = {};\nlet possuiMedidas = false;\n\nfor (const campo of camposMedidas) {\n  if (body[campo] !== undefined && body[campo] !== null && body[campo] !== \"\") {\n    medidasClienteLimpas[campo] = body[campo];\n    possuiMedidas = true;\n  }\n}\n\nreturn {\n  json: {\n    metadata: {\n      cliente_id: clienteId,\n      sku: produto.sku || body.sku || body.sku_id || \"N/A\",\n      timestamp: new Date().toISOString()\n    },\n    status_validacao: {\n      sku_encontrado: possuiTabela, // Mantido o nome para não quebrar a regra do nó If\n      possui_medidas: possuiMedidas\n    },\n    detalhes_produto: {\n      nome_peca: produto.nome_peca || body.nome_peca || \"Não especificado\",\n      comprimento_peca: produto.comprimento_peca || body.comprimento || \"Não especificado\"\n    },\n    medidas_cliente: medidasClienteLimpas,\n    tabela_medidas_produto: tabelaLimpa\n  }\n};"
      },
