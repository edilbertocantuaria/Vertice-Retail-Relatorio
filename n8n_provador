    {
      "parameters": {
        "jsCode": "const payload = $('Consolida Payload').first().json;\nconst meta = payload.metadata;\nconst validacao = payload.status_validacao;\n\nlet recomendacaoText = \"\";\nlet fatorConfianca = \"\";\n\nif (!validacao.sku_encontrado) {\n  recomendacaoText = \"Este produto ainda não conta com a funcionalidade de provador virtual.\";\n  fatorConfianca = \"Indisponível (SKU não cadastrado)\";\n} else if (!validacao.possui_medidas) {\n  recomendacaoText = \"Você deve informar pelo menos uma medida para utilizar o provador virtual. Quanto mais medidas você adicionar, melhor será recomendação de tamanho da peça.\";\n  fatorConfianca = \"Sem dados corporais\";\n}\n\nreturn {\n  json: {\n    cliente_id: meta.cliente_id,\n    sku: meta.sku,\n    timestamp: meta.timestamp,\n    tamanho_recomendado: \"N/A\",\n    fator_confianca: fatorConfianca,\n    recomendacao_consultiva: recomendacaoText,\n    texto_resposta: recomendacaoText\n  }\n};"
      },
