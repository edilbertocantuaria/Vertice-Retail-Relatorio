    {
      "parameters": {
        "jsCode": "const body = $('Entrada de Dados (Webhook)').first().json.body || $('Entrada de Dados (Webhook)').first().json;\nconst clienteId = body.cliente_id || body.customer_id || \"ANONYMOUS\";\nconst produto = body.produto || {};\n\nconst tabelaOriginal = produto.tabela_medidas || body.tabela_medidas || [];\nconst possuiLinhas = Array.isArray(tabelaOriginal) && tabelaOriginal.length > 0;\n\nconst tabelaLimpa = possuiLinhas ? tabelaOriginal.map(row => {\n  const rowLimpa = {};\n  for (const [chave, valor] of Object.entries(row)) {\n    if (valor !== null && valor !== \"\" && valor !== undefined) {\n      rowLimpa[chave] = valor;\n    }\n  }\n  return rowLimpa;\n}) : [];\n\nconst possuiFaixasNumericas = tabelaLimpa.some(row =>\n  Object.keys(row).some(k => k.endsWith('_min') || k.endsWith('_max'))\n);\n\nconst ehTamanhoUnico = !possuiFaixasNumericas && tabelaLimpa.some(row => {\n  const valor = (row.tamanho || \"\")\n    .toString()\n    .normalize(\"NFD\")\n    .replace(/[\\u0300-\\u036f]/g, \"\")\n    .toLowerCase();\n\n  return valor === \"unico\";\n});\n\nconst tabelaUtilizavel = possuiLinhas && (possuiFaixasNumericas || ehTamanhoUnico);\n\nconst fonteMedidas = body.medidas_cliente || body;\nconst camposMedidas = [\n  'cintura',\n  'busto',\n  'quadril',\n  'altura',\n  'comprimento_corpo',\n  'coxa',\n  'ombro'\n];\n\nconst medidasClienteLimpas = {};\nlet possuiMedidas = false;\n\nfor (const campo of camposMedidas) {\n  if (\n    fonteMedidas[campo] !== undefined &&\n    fonteMedidas[campo] !== null &&\n    fonteMedidas[campo] !== \"\"\n  ) {\n    medidasClienteLimpas[campo] = Number(fonteMedidas[campo]);\n    possuiMedidas = true;\n  }\n}\n\nreturn {\n  json: {\n    metadata: {\n      cliente_id: clienteId,\n      sku: produto.sku || body.sku || \"N/A\",\n      timestamp: new Date().toISOString()\n    },\n\n    status_validacao: {\n      sku_encontrado: tabelaUtilizavel,\n      possui_medidas: possuiMedidas,\n      eh_tamanho_unico: ehTamanhoUnico\n    },\n\n    detalhes_produto: {\n      nome_peca: produto.nome_peca || body.nome_peca || \"Não especificado\"\n    },\n\n    medidas_cliente: medidasClienteLimpas,\n    tabela_medidas: tabelaLimpa\n  }\n};"
      },
