      "parameters": {
        "jsCode": "const meta = $('Consolida Payload').first().json.metadata;\n\nlet raw = $('IA Provador Virtual').first().json.text || \"\";\nraw = raw.replace(/```json/gi, \"\").replace(/```/g, \"\").trim();\n\nlet iaOutput;\ntry {\n  iaOutput = JSON.parse(raw);\n} catch (e) {\n  iaOutput = { erro: \"Nao foi possivel interpretar a resposta da IA\", resposta_bruta: raw };\n}\n\nconst textoResposta = iaOutput.recomendacao_consultiva;\n\nreturn {\n  json: {\n    cliente_id: meta.cliente_id,\n    sku: meta.sku,\n    timestamp: meta.timestamp,\n    tamanho_recomendado: iaOutput.tamanho_recomendado,\n    fator_confianca: iaOutput.fator_confianca,\n    recomendacao_consultiva: iaOutput.recomendacao_consultiva,\n    texto_resposta: textoResposta\n  }\n};"
      },
