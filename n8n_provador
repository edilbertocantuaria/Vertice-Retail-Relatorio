      "parameters": {
        "jsCode": "const payload = $('Consolida Payload').first().json;\nconst meta = payload.metadata;\nconst medidas = payload.medidas_cliente || {};\nconst tabela = payload.tabela_medidas || [];\n\n// Identifica as medidas corporais exigidas na tabela_medidas (ex: cintura, busto, quadril)\nconst camposNecessarios = new Set();\ntabela.forEach(row => {\n  Object.keys(row).forEach(key => {\n    if (key.endsWith('_min') || key.endsWith('_max')) {\n      camposNecessarios.add(key.replace('_min', '').replace('_max', ''));\n    }\n  });\n});\n\n// Verifica se o cliente enviou todas as medidas exigidas pela tabela\nconst camposCliente = Object.keys(medidas);\nconst todasPreenchidas = camposNecessarios.size > 0 && Array.from(camposNecessarios).every(campo => camposCliente.includes(campo));\nconst statusMedidas = todasPreenchidas ? \"Completas\" : \"Parciais\";\n\nconst textoResposta = $('IA Provador Virtual').first().json.text || \"Não foi possível gerar a recomendação.\";\n\nreturn {\n  json: {\n    cliente_id: meta.cliente_id,\n    sku: meta.sku,\n    timestamp: meta.timestamp,\n    status_medidas: statusMedidas,\n    recomendacao_consultiva: textoResposta,\n    texto_resposta: textoResposta\n  }\n};"
      },
